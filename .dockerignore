**/*.rs.bk
*.pdb

# Frontend - Build artifacts and dependencies
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.svelte-kit/
frontend/.cache/
node_modules/

# Testing
tests/
**/*_test.rs
**/*_tests.rs

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# Docker
docker-compose*.yml
docker/*.Dockerfile
.dockerignore

# Environment files
.env
.env.*
!.env.example

# Scripts that aren't needed in build
scripts/*.sh
scripts/*.py

# Misc
*.log
*.tmp
*.temp
