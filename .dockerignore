# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Rust - Local build artifacts
target/
**/target/
backend/target/
backend/**/target/
