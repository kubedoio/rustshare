# ⚠️  WARNING: This file contains EMPTY secret placeholders.
#    You MUST generate strong secrets before first use.
#    Run scripts/pre-flight.sh or use openssl rand -base64 32
#    to populate the values below. The application will refuse
#    to start with weak or missing credentials.

# Database
DATABASE_URL=

# Database connection pool tuning
DB_POOL_MAX_CONNECTIONS=50
DB_POOL_MIN_CONNECTIONS=5
DB_POOL_ACQUIRE_TIMEOUT_SECS=10
DB_POOL_IDLE_TIMEOUT_SECS=300
DB_POOL_MAX_LIFETIME_SECS=1800

# RustFS (S3-compatible storage)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=rustshare-data
RUSTFS_REGION=us-east-1
# Production should provision the bucket out-of-band. Set true only for local/dev bootstrap.
RUSTSHARE_OBJECT_STORE_AUTO_CREATE_BUCKET=false

# Authentication
JWT_SECRET=
JWT_ISSUER=rustshare
JWT_AUDIENCE=rustshare-api
JWT_EXPIRY_HOURS=24

# Mark session cookies with the Secure flag (HTTPS only).
# Default is true in production. Set to false for local development on http://localhost.
SESSION_COOKIE_SECURE=false

# Secret encryption key for sensitive data at rest
# CRITICAL: Must be a strong base64-encoded 32-byte key.
# Generate with: openssl rand -base64 32
RUSTSHARE_SECRET_ENCRYPTION_KEY=

# Admin user (created on first boot if no users exist)
RUSTSHARE_ADMIN_EMAIL=admin@localhost
RUSTSHARE_ADMIN_PASSWORD=
RUSTSHARE_BOOTSTRAP_PASSWORD_FILE=/tmp/rustshare-bootstrap-password.txt

# Chat integration (required for startup)
RUSTSHARE_CHAT_WEBHOOK_SECRET=

# Maximum age in seconds for incoming chat webhook event timestamps.
# Events with timestamps outside this window are rejected as replay attacks.
# Default: 300 (5 minutes).
RUSTSHARE_WEBHOOK_MAX_AGE_SECONDS=300

# Chat source authority: "buzz" is the production/dogfood mode — every
# channel/message decision comes from the community's authoritative Buzz
# relay via the v1alpha1 upstream contract (requires the bridge secret key
# below). "local" is the explicit dev fallback (coarse community gate, no
# relay). Misconfigured buzz mode (missing bridge key) hard-fails at
# startup — there is no silent fallback to local.
RUSTSHARE_CHAT_AUTHORITY=local
# NIP-98 service key used to query the Buzz relay for current
# channel/message authorization (64 lowercase hex; required in buzz mode,
# leave empty in local mode)
RUSTSHARE_CHAT_BRIDGE_SECRET_KEY=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Logging
RUST_LOG=info,rustshare=debug

# Log output format
# Options: json, pretty
# Use json for production (structured logging), pretty for development
RUSTSHARE_LOG_FORMAT=json

# Event broadcaster channel capacity
BROADCAST_CAPACITY=1000

# Public URL for QR code generation (fallback when Host header unavailable)
RUSTSHARE_PUBLIC_URL=http://localhost:8080

# Default per-user storage quota in bytes
RUSTSHARE_DEFAULT_STORAGE_QUOTA_BYTES=10737418240

# Enable AI endpoints (search, summarize, ask)
RUSTSHARE_AI_ENABLED=true

# Optional OpenAI-compatible provider for /api/v1/memory/ask.
# Without a key, Search works and Ask returns 503.
# ELEMBRA_LLM_API_KEY=
# ELEMBRA_LLM_BASE_URL=https://api.openai.com/v1
# ELEMBRA_LLM_MODEL=gpt-4o-mini
# ELEMBRA_LLM_TIMEOUT_SECS=30
# ELEMBRA_LLM_MAX_OUTPUT_TOKENS=1500
# ELEMBRA_LLM_TEMPERATURE=

# Optional bearer token for the Prometheus /metrics endpoint.
# If set, scrapers must send "Authorization: Bearer <token>".
# Leave empty to keep /metrics open (not recommended for public deployments).
METRICS_API_TOKEN=

# Durable integration-event outbox (ADR-0031)
# Asynchronous dispatcher delivering outbox events to registered consumers.
# Publishing stays active even when the worker is disabled; events then
# accumulate until it is enabled again.
RUSTSHARE_OUTBOX_WORKER_ENABLED=true
# Poll interval between dispatcher ticks (ms)
RUSTSHARE_OUTBOX_POLL_INTERVAL_MS=1000
# Maximum rows claimed per consumer per tick
RUSTSHARE_OUTBOX_CLAIM_BATCH_SIZE=50
# Lease duration in seconds for a claimed delivery
RUSTSHARE_OUTBOX_LEASE_SECS=60
# Maximum attempts before a delivery is dead-lettered
RUSTSHARE_OUTBOX_MAX_ATTEMPTS=5
# Retry backoff bounds in milliseconds (exponential, at least 1s per step)
RUSTSHARE_OUTBOX_BACKOFF_INITIAL_MS=1000
RUSTSHARE_OUTBOX_BACKOFF_MAX_MS=300000
# Outbox retention in hours before fully-delivered rows are compacted (0 disables)
RUSTSHARE_OUTBOX_RETENTION_HOURS=168
# Per-event processing deadline in seconds: a consumer that does not return in
# time has its delivery failed retryable (bounded backoff, then DLQ), so a
# wedged consumer cannot stall the dispatch loop.
RUSTSHARE_OUTBOX_PROCESS_TIMEOUT_SECS=60
# Readiness staleness window: outbox is unhealthy while the last dispatcher
# tick is older than this many seconds
RUSTSHARE_OUTBOX_READINESS_STALENESS_SECS=60

# Data retention cleanup worker
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_SECS=86400
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_FILE_VERSIONS_DAYS=180
RETENTION_EXPIRED_SESSIONS_DAYS=30
RETENTION_EXPIRED_SHARES_DAYS=30
RETENTION_REPLICATION_HISTORY_DAYS=90
RETENTION_OIDC_STATE_DAYS=1
RETENTION_DEVICE_PAIR_DAYS=7
RETENTION_WEBHOOK_LOG_DAYS=30
