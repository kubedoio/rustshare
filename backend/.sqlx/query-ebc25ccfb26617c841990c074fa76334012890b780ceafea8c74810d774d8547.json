  "query": "\n            SELECT\n                id,\n                event_type,\n                description,\n                ip_address,\n                user_agent,\n                session_id,\n                occurred_at\n            FROM user_security_events\n            WHERE user_id = $1\n            ORDER BY occurred_at DESC\n            LIMIT $2\n            ",
