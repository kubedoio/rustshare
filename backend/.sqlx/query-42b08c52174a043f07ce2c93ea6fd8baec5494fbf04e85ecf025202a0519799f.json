{
  "db_name": "PostgreSQL",
  "query": "SELECT f.id, f.name, f.modified_at, f.parent_folder_id, pf.name as parent_name FROM files f LEFT JOIN folders pf ON f.parent_folder_id = pf.id WHERE f.tenant_id = $1 AND f.owner_id = $2 AND f.deleted_at IS NULL AND f.path LIKE $3 ORDER BY f.modified_at DESC LIMIT $4",
