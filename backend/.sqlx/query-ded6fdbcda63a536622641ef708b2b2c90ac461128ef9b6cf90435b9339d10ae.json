  "query": "\n                SELECT id, user_id,\n                       notification_type as \"notification_type: _\",\n                       title, message,\n                       resource_id,\n                       resource_type as \"resource_type: _\",\n                       action_url, read, created_at, tenant_id\n                FROM notifications\n                WHERE user_id = $1\n                ORDER BY created_at DESC\n                LIMIT $2 OFFSET $3\n                ",
