  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, name, path, parent_folder_id, owner_id, created_at, updated_at, starred_at, deleted_at, tenant_id,\n                NULL::uuid[] as \"ancestor_ids: _\"\n            FROM folders\n            WHERE owner_id = $1\n              AND tenant_id = $2\n              AND deleted_at IS NULL\n            ORDER BY path ASC\n            ",
