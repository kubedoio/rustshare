# ============================================
# RustShare Zero-PostgreSQL Environment Variables
# ============================================
# Copy this file to .env and update values for your deployment
# Never commit .env to version control
#
# This is the new zero-PostgreSQL configuration.
# PostgreSQL is no longer required - RustFS is the canonical metadata store.

# ============================================
# Runtime Profile (NEW)
# ============================================
# Select the runtime profile:
#   standalone    - Single node, local filesystem metadata (default for dev)
#   distributed   - Multiple nodes, Redis coordination (production)
#
# Standalone mode uses local filesystem for metadata.
# Distributed mode requires Redis for coordination.
RUSTSHARE_RUNTIME_PROFILE=standalone

# ============================================
# Redis Configuration (Required for distributed profile)
# ============================================
# Redis is used for ephemeral coordination in distributed mode:
# - Session revocation cache
# - Rate limiting counters
# - Job claim coordination
# - WebSocket presence
#
# Not required for standalone mode.
RUSTSHARE_REDIS_ENABLED=false
# RUSTSHARE_REDIS_URL=redis://localhost:6379

# ============================================
# Object Storage Configuration (RustFS/S3)
# ============================================
# REQUIRED: S3-compatible storage for files AND metadata
# 
# For RustFS Docker: http://rustfs:9000
# For local RustFS: http://localhost:9000
# For AWS S3: https://s3.amazonaws.com
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=rustshare-files

# S3 credentials
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=changeme

# ============================================
# Metadata Storage Configuration
# ============================================
# Local storage path (standalone mode only)
# Used for metadata when running in standalone mode
RUSTSHARE_LOCAL_STORAGE_PATH=./rustshare-data

# Metadata object prefix in RustFS
RUSTSHARE_METADATA_PREFIX=apps/rustshare

# Metadata namespace for multi-tenancy
RUSTSHARE_METADATA_NAMESPACE=default

# Enable in-memory metadata cache
RUSTSHARE_METADATA_CACHE=true

# ============================================
# Authentication & Security
# ============================================
# CRITICAL: Change this to a strong random value in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production

# Secret encryption key for sensitive data
# Generate with: openssl rand -base64 32
RUSTSHARE_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ============================================
# Server Configuration
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ============================================
# Rate Limiting
# ============================================
RUSTSHARE_RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=10
RUSTSHARE_RATE_LIMIT_OIDC_LOGIN_PER_MINUTE=30
RUSTSHARE_RATE_LIMIT_SHARE_SESSION_PER_MINUTE=5
RUSTSHARE_RATE_LIMIT_SHARE_INFO_PER_MINUTE=30
RUSTSHARE_RATE_LIMIT_SHARE_DOWNLOAD_PER_MINUTE=30
RUSTSHARE_RATE_LIMIT_SHARE_UPLOAD_PER_MINUTE=20
RUSTSHARE_RATE_LIMIT_AUTHENTICATED_SHARE_ADMIN_PER_MINUTE=120

# ============================================
# User Quotas & Limits
# ============================================
RUSTSHARE_DEFAULT_STORAGE_QUOTA_BYTES=10737418240

# ============================================
# Admin User (Optional)
# ============================================
RUSTSHARE_ADMIN_USERNAME=admin
RUSTSHARE_ADMIN_EMAIL=admin@localhost
RUSTSHARE_ADMIN_PASSWORD=admin123

# ============================================
# OIDC Configuration (Optional)
# ============================================
# PASSWORD_LOGIN_ENABLED=true
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
# OIDC_LOGIN_LABEL=
# OIDC_SCOPES=openid profile email

# ============================================
# Logging & Debugging
# ============================================
RUST_LOG=info,rustshare=debug

# ============================================
# WebSocket Configuration
# ============================================
BROADCAST_CAPACITY=1000

# ============================================
# Frontend Configuration
# ============================================
ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/api
FRONTEND_DIST_DIR=/app/frontend-build

# ============================================
# Production Deployment Checklist
# ============================================
# [ ] Generate strong JWT_SECRET (openssl rand -base64 32)
# [ ] Generate strong RUSTSHARE_SECRET_ENCRYPTION_KEY
# [ ] Change RustFS credentials (RUSTFS_ROOT_USER/PASSWORD)
# [ ] Update AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# [ ] Set RUSTSHARE_RUNTIME_PROFILE (standalone or distributed)
# [ ] For distributed: Configure Redis and set RUSTSHARE_REDIS_ENABLED=true
# [ ] Set ORIGIN to your production domain
# [ ] Configure SSL/TLS with reverse proxy
# [ ] Adjust RUSTSHARE_DEFAULT_STORAGE_QUOTA_BYTES based on capacity
# [ ] Set RUST_LOG to info for production
# [ ] Configure firewall rules
# [ ] Set up RustFS/S3 backups
# [ ] Review rate limiting settings

# ============================================
# Legacy Configuration (NOT USED in zero-PostgreSQL)
# ============================================
# The following are no longer needed and are ignored:
# - DATABASE_URL (PostgreSQL is not used)
# - RUSTSHARE_METADATA_BACKEND (always uses RustFS now)
