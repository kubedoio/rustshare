# ============================================
# RustShare Production Environment Variables
# ============================================
# Copy this file to .env and update values for your deployment
# Never commit .env to version control

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://rustshare:changeme@postgres:5432/rustshare

# ============================================
# Object Storage Configuration (MinIO/S3)
# ============================================
# S3-compatible storage endpoint
# For MinIO: http://rustfs:9000 (Docker) or http://localhost:9000 (local)
# For AWS S3: https://s3.amazonaws.com or https://s3.region.amazonaws.com
STORAGE_ENDPOINT=http://rustfs:9000

# S3 access credentials
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin

# S3 bucket name for file storage
STORAGE_BUCKET=rustshare-files

# S3 region (use 'us-east-1' for MinIO)
STORAGE_REGION=us-east-1

# ============================================
# Authentication & Security
# ============================================
# CRITICAL: Change this to a strong random value in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production

# JWT token expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24

# ============================================
# Server Configuration
# ============================================
# Server bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=8080

# ============================================
# Rate Limiting
# ============================================
# Maximum requests per minute per IP address
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Burst capacity for rate limiting (optional)
RATE_LIMIT_BURST=100

# ============================================
# User Quotas & Limits
# ============================================
# Default storage quota per user in GB
DEFAULT_USER_QUOTA_GB=10

# Maximum file upload size in MB (optional)
MAX_UPLOAD_SIZE_MB=5000

# ============================================
# Frontend Configuration
# ============================================
# SvelteKit origin (used for CSRF protection)
# Set to your domain in production (e.g., https://files.example.com)
ORIGIN=http://localhost:3000

# Backend API URL (from frontend's perspective)
# In Docker: http://backend:8080/api (internal)
# For browser: http://localhost/api (via nginx proxy)
VITE_API_URL=http://localhost/api

# WebSocket URL for real-time sync
# In Docker: ws://backend:8080/api (internal)
# For browser: ws://localhost/api (via nginx proxy)
VITE_WS_URL=ws://localhost/api

# ============================================
# Admin User (Optional)
# ============================================
# Default admin account created on first boot if no users exist
RUSTSHARE_ADMIN_EMAIL=admin@localhost
RUSTSHARE_ADMIN_PASSWORD=admin123

# ============================================
# Logging & Debugging
# ============================================
# Rust logging level
# Options: error, warn, info, debug, trace
# Use info for production, debug for development
RUST_LOG=info,rustshare=debug

# ============================================
# Production Deployment Checklist
# ============================================
# [ ] Generate strong JWT_SECRET (openssl rand -base64 32)
# [ ] Update database password in docker-compose.yml
# [ ] Change MinIO credentials (MINIO_ROOT_USER/PASSWORD)
# [ ] Update STORAGE_ACCESS_KEY and STORAGE_SECRET_KEY
# [ ] Set ORIGIN to your production domain
# [ ] Configure SSL/TLS with reverse proxy
# [ ] Adjust DEFAULT_USER_QUOTA_GB based on capacity
# [ ] Set RUST_LOG to info for production
# [ ] Configure firewall rules
# [ ] Set up database backups
# [ ] Set up MinIO/S3 backups
