# ============================================
# RustShare Production Environment Variables
# ============================================
# Copy this file to .env and update values for your deployment
# Never commit .env to version control
# ⚠️  WARNING: This file contains EMPTY secret placeholders.
#    You MUST run scripts/pre-flight.sh to generate strong secrets
#    before first use. The application will refuse to start with
#    weak or missing credentials.
# ============================================
# Database Configuration
# ============================================
# PostgreSQL password (used by postgres service and DATABASE_URL)
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=

# ============================================
# Object Storage Configuration (RustFS/S3)
# ============================================
# AWS credentials (used when backend talks directly to S3/RustFS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Safe content-addressed blob garbage collection (disabled by default).
# Candidate enqueueing remains active while deletion is disabled.
RUSTSHARE_OBJECT_GC_ENABLED=false
RUSTSHARE_OBJECT_GC_INTERVAL_SECONDS=300
RUSTSHARE_OBJECT_GC_BATCH_SIZE=50
RUSTSHARE_OBJECT_GC_GRACE_PERIOD_HOURS=24
RUSTSHARE_OBJECT_GC_MAX_ATTEMPTS=10
RUSTSHARE_OBJECT_GC_LEASE_SECONDS=900
RUSTSHARE_OBJECT_GC_MAX_BACKOFF_SECONDS=86400

# Connection pool for cross-process content-addressed blob writer/GC locks.
# Increase the pool size or acquire timeout if concurrent uploads see lock
# acquisition timeouts under load.
RUSTSHARE_BLOB_LOCK_POOL_MAX_CONNECTIONS=16
RUSTSHARE_BLOB_LOCK_POOL_ACQUIRE_TIMEOUT_SECONDS=30

# Durable integration-event outbox (ADR-0031): per-event processing deadline
# in seconds. A consumer that does not return in time has its delivery failed
# retryable (bounded backoff, then DLQ), so a wedged consumer cannot stall the
# dispatch loop.
RUSTSHARE_OUTBOX_PROCESS_TIMEOUT_SECS=60

# ============================================
# Authentication & Security
# ============================================
# CRITICAL: Change this to a strong random value in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Secret encryption key for sensitive data at rest
# CRITICAL: Must be a strong random value. Server refuses to start with weak defaults.
# Generate with: openssl rand -base64 32
RUSTSHARE_SECRET_ENCRYPTION_KEY=

# Allow Mail (IMAP/SMTP) connections to internal/private servers (default: false)
# Required for self-hosted or air-gapped mail servers on private networks.
# RUSTSHARE_ALLOW_INTERNAL_MAIL_SERVERS=true

# Accept invalid TLS certificates for internal/private mail servers (default: internal)
# Internal mail servers are often self-signed or reached by IP address, so invalid
# certificates are accepted by default when internal servers are enabled. Public
# mail servers always get full certificate verification.
# Set to "never" to require valid certificates even for internal servers.
# RUSTSHARE_MAIL_TLS_ACCEPT_INVALID_CERTS=internal

# ============================================
# Chat Source Authorization
# ============================================
# Chat source authority: local (coarse community gate) or buzz (upstream access/check; requires the bridge secret key below)
RUSTSHARE_CHAT_AUTHORITY=local
# NIP-98 service key used to query the Buzz relay for current channel/message authorization (64 lowercase hex; leave empty in local mode)
RUSTSHARE_CHAT_BRIDGE_SECRET_KEY=

# ============================================
# Server Configuration
# ============================================
# Server bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
# Docker deployments should override this to 0.0.0.0 so the container can accept external connections
# [dev-only] Use 0.0.0.0 for any containerized or remote deployment.
SERVER_HOST=127.0.0.1

# Server port
# [dev-only] Override if you run the server on a non-default port.
SERVER_PORT=8080

# ============================================
# User Quotas & Limits
# ============================================
# Maximum file upload size in MB (optional)
# [dev-only] Adjust in production based on your reverse-proxy limits.
MAX_UPLOAD_SIZE_MB=5000

# ============================================
# Frontend Configuration
# ============================================
# Backend API URL (from frontend's perspective)
# In Docker: http://backend:8080/api (internal)
# For browser: http://localhost/api (via nginx proxy)
# [dev-only] Update in production to match your public API URL.
VITE_API_URL=http://localhost/api

# WebSocket URL for real-time sync
# In Docker: ws://backend:8080/api (internal)
# For browser: ws://localhost/api (via nginx proxy)
# [dev-only] Update in production to match your public WebSocket URL.
VITE_WS_URL=ws://localhost/api

# ============================================
# Admin User (Optional)
# ============================================
# RustFS root credentials (must match AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
RUSTFS_ROOT_USER=
RUSTFS_ROOT_PASSWORD=

# Default admin account created on first boot if no users exist
# [dev-only] Change the email in production if you do not use admin@localhost.
# RUSTSHARE_ADMIN_PASSWORD: set this BEFORE first start for a durable admin
# password. If left empty, a random password is generated ONCE at first boot
# and written to a bootstrap file inside the container (see README /
# docs/DEPLOYMENT.md) — record it immediately, it does not survive container
# recreation.
RUSTSHARE_ADMIN_EMAIL=admin@localhost
RUSTSHARE_ADMIN_PASSWORD=

# Optional demo viewer account (created on first boot)
# [dev-only] Demo accounts should be disabled or removed in production.
RUSTSHARE_DEMO_VIEWER_USERNAME=viewer
RUSTSHARE_DEMO_VIEWER_EMAIL=viewer@localhost
RUSTSHARE_DEMO_VIEWER_PASSWORD=
RUSTSHARE_DEMO_VIEWER_DISPLAY_NAME="Viewer User"

# ============================================
# Logging & Debugging
# ============================================
# Rust logging level
# Options: error, warn, info, debug, trace
# Use info for production, debug for development
# [dev-only] Set to info in production to reduce log volume and avoid leaking details.
RUST_LOG=info,rustshare=debug

# ============================================
# Metadata Backend Configuration
# ============================================
# Select the metadata storage backend
# Options:
#   postgres      - PostgreSQL only (legacy, default)
#   rustfs        - RustFS/object storage only (new system)
#   dual_write    - Write to both, read from PostgreSQL (migration)
#   rustfs_reads  - Write to both, read from RustFS (migration)
#   localfs       - Local filesystem (development only)
# [dev-only] localfs is for development only; use postgres or rustfs in production.
RUSTSHARE_METADATA_BACKEND=postgres

# Metadata object prefix in object storage
# Default: apps/rustshare
# [dev-only] Override if your object-storage layout differs.
RUSTSHARE_METADATA_PREFIX=apps/rustshare

# Metadata namespace for multi-tenancy
# Default: default
# [dev-only] Override for multi-tenant deployments.
RUSTSHARE_METADATA_NAMESPACE=default

# Enable in-memory metadata cache
# Default: true
# [dev-only] Usually safe to leave enabled; disable only for debugging.
RUSTSHARE_METADATA_CACHE=true

# ============================================
# Production Deployment Checklist
# ============================================
# [ ] Generate strong JWT_SECRET (openssl rand -base64 32)
# [ ] Update database password in .env
# [ ] Change RustFS credentials (RUSTFS_ROOT_USER/PASSWORD)
# [ ] Update AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# [ ] Set VITE_API_URL to your production API URL
# [ ] Configure SSL/TLS with reverse proxy
# [ ] Adjust RUSTSHARE_DEFAULT_STORAGE_QUOTA_BYTES based on capacity
# [ ] Set RUST_LOG to info for production
# [ ] Configure firewall rules
# [ ] Set up database backups
# [ ] Set up RustFS/S3 backups
# [ ] Plan metadata migration (see docs/2026-03-27-metadata-refactor-design.md)
