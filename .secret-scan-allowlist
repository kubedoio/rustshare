# Secret-scan allowlist
# Each non-comment, non-empty line is a regex. If a scan match contains the
# pattern anywhere on the matched line, it is treated as a false positive.
# Keep patterns as specific as possible to avoid masking real secrets.

# Default admin email address (not a secret).
admin@localhost

# Safe placeholder values explicitly used by test fixtures and docs.
test-secret-key-that-is-long-enough
super-secret-generated-password-12345
smtp-plaintext-password-123

# Operational smoke-test scripts use deterministic local-dev fallback passwords.
# These are not production secrets; the scripts are only run against local stacks.
final-launch-smoke\.sh:.*ADMIN_PASSWORD \(default: admin123\)
final-launch-smoke\.sh:.*VIEWER_PASSWORD \(default: viewer123\)
final-launch-smoke\.sh:.*ADMIN_PASSWORD="\$\{ADMIN_PASSWORD:-admin123\}"
final-launch-smoke\.sh:.*VIEWER_PASSWORD="\$\{VIEWER_PASSWORD:-viewer123\}"
final-launch-smoke\.sh:.*login_with_password .*"admin123"
replication-health-check\.sh:.*ADMIN_PASSWORD \(default: admin123\)
replication-health-check\.sh:.*ADMIN_PASSWORD="\$\{ADMIN_PASSWORD:-admin123\}"

# scripts/pre-flight.sh intentionally lists weak default placeholders so it can
# replace them with generated values during setup.
pre-flight\.sh.*AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
pre-flight\.sh.*changeme
pre-flight\.sh.*rustfsadmin
