# Secret-scan allowlist
# Each non-comment, non-empty line is a regex. If a scan match contains the
# pattern anywhere on the matched line, it is treated as a false positive.
# Keep patterns as specific as possible to avoid masking real secrets.

# Default admin email address (not a secret).
admin@localhost

# Safe placeholder values explicitly used by test fixtures and docs.
test-secret-key-that-is-long-enough
super-secret-generated-password-12345
smtp-plaintext-password-123
allowlisted-local-dev-placeholder

# The scanner self-test intentionally contains secret-like fixture strings in
# heredoc lines; allowlist only those specific fixtures inside the test script.
scripts/secret-scan-test\.sh:.*JWT_SECRET=known-secret-value-12345
scripts/secret-scan-test\.sh:.*ENV JWT_SECRET=docker-secret-123
scripts/secret-scan-test\.sh:.*-e JWT_SECRET=inline-secret-123


# scripts/pre-flight.sh intentionally lists weak default placeholders so it can
# replace them with generated values during setup. Keep patterns tied to the
# specific SECRET_SPECS declarations rather than broad substring matches.
pre-flight\.sh.*RUSTSHARE_SECRET_ENCRYPTION_KEY\|secret\|32\|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
pre-flight\.sh.*POSTGRES_PASSWORD\|password\|16\|changeme
pre-flight\.sh.*RUSTFS_ROOT_USER\|access_key\|4\|rustfsadmin
pre-flight\.sh.*RUSTFS_ROOT_PASSWORD\|password\|16\|rustfsadmin

# scripts/pre-flight.sh compares values against the weak default "rustfsadmin"
# when deciding whether to derive S3 credentials from RustFS root credentials.
pre-flight\.sh.*\[\[ -z "\$\{value\}" \|\| "\$\{value\}" == "rustfsadmin" \]\]

# The scanner self-test intentionally contains a secret-like source fixture in
# a heredoc to verify that --full scans source-code files.
scripts/secret-scan-test\.sh:.*export const API_KEY = "a1b2c3d4e5f6789012345678abcdef0011223344";

# Rust source: configuration field declarations and constructor assignments
# (not literal secret values).
:.*pub jwt_secret: String,
:.*jwt_secret: jwt_secret\.into\(\),
:.*pub rustshare_chat_webhook_secret: String,

# Rust source: reading JWT_SECRET from the environment at runtime.
:.*let jwt_secret = std::env::var\("JWT_SECRET"\)\?;

# Rust source: intentional guard against the known-weak default encryption key.
bootstrap\.rs:.*encryption_key == "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

# Rust source / tests: deterministic SHA-256 content hashes used as test fixtures.
:.*sha256: "[a-f0-9]{64}"\.to_string\(\),
:.*content_hash = "[a-f0-9]{64}";
:.*empty_hash = "[a-f0-9]{64}"\.to_string\(\);
:.*hash: "[a-f0-9]{64}"\.to_string\(\),
:.*content_hash: "[a-f0-9]{64}"

# Rust source / tests: hardcoded test password for password-protected share tests.
share_service\.rs:.*password123

# Rust source / tests: local-only test database URLs with placeholder passwords.
:.*TEST_DATABASE_URL:.*postgres://rustshare:(changeme|rustshare)@localhost
:.*postgres://rustshare:changeme@localhost:5432/rustshare
:.*postgres://rustshare:rustshare@localhost/rustshare_test

# Rust source: utoipa API path annotations.
chat_integration\.rs:.*path = "/api/v1/.*",
