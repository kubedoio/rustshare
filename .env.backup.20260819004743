# ============================================
# Server Configuration
# ============================================
# Server bind address (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=8080

# ============================================
# Rate Limiting
# ============================================
# Maximum requests per minute per IP address
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Burst capacity for rate limiting (optional)
RATE_LIMIT_BURST=100

# ============================================
# User Quotas & Limits
# ============================================
# Default storage quota per user in GB
DEFAULT_USER_QUOTA_GB=10

# Maximum file upload size in MB (optional)
MAX_UPLOAD_SIZE_MB=5000

# ============================================
# Frontend Configuration
# ============================================
# SvelteKit origin (used for CSRF protection)
# Set to your domain in production (e.g., https://files.example.com)
ORIGIN=https://app.rustshare.io

# Backend API URL (from frontend's perspective)
# In Docker: http://backend:8080/api (internal)
# For browser: http://localhost/api (via nginx proxy)
VITE_API_URL=https://localhost/api

# WebSocket URL for real-time sync
# In Docker: ws://backend:8080/api (internal)
# For browser: ws://localhost/api (via nginx proxy)
VITE_WS_URL=ws://localhost/api

# ============================================
# Admin User (Optional)
# ============================================
# Default admin account created on first boot if no users exist
RUSTSHARE_ADMIN_EMAIL=admin@localhost
# ============================================
# Metadata Backend Configuration
# ============================================
# Select the metadata storage backend
# Options:
#   postgres      - PostgreSQL only (legacy, default)
#   rustfs        - RustFS/object storage only (new system)
#   dual_write    - Write to both, read from PostgreSQL (migration)
#   rustfs_reads  - Write to both, read from RustFS (migration)
#   localfs       - Local filesystem (development only)
RUSTSHARE_METADATA_BACKEND=postgres

# Metadata object prefix in object storage
# Default: apps/rustshare
RUSTSHARE_METADATA_PREFIX=apps/rustshare

# Metadata namespace for multi-tenancy
# Default: default
RUSTSHARE_METADATA_NAMESPACE=default

# Enable in-memory metadata cache
# Default: true
RUSTSHARE_METADATA_CACHE=true

# Local filesystem path (only for localfs backend)
# RUSTSHARE_LOCALFS_PATH=./local-metadata

# ============================================
# Logging & Debugging
# ============================================
# Rust logging level
# Options: error, warn, info, debug, trace
# Use info for production, debug for development
RUST_LOG=info,rustshare=debug

